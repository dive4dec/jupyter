#!/bin/bash
# dsh-openai-shim boot hook — start the dsh OpenAI proxy daemon (a3: in-pod).
#
# Installed to /usr/local/bin/before-notebook.d/40-dsh-proxy (NO .sh extension)
# and run by start.sh's run-hooks() immediately before the notebook is exec'd,
# as the notebook user (jovyan) in edbt (PID 1 = tini runs as jovyan; no
# root->sudo drop), so $HOME is the NFS home.
#
# CRITICAL: this file must NOT end in .sh. run-hooks() *sources* *.sh files
# (source "${f}") but *executes* other executable files ("${f}"). This hook
# calls `exit`, which — if the file were sourced — would terminate start.sh
# itself and kill the notebook boot. As a child process, `exit` is safe and
# its `set +e` cannot leak into start.sh. It needs no env from the parent
# (it uses $HOME + the on-disk proxy.conf), so a clean child is correct.
#
# It must not block or fail the notebook start, so everything is defensive and
# the daemon is detached.
#
# The proxy is the intended way to drive dsh (terminal / code-server / VS Code
# point dsh at this loopback endpoint). ALL providers — the deployment's and
# any the student adds — live in ~/.dsh/proxy.conf. This hook runs the single
# startup orchestrator `dsh-proxy ensure`, which upserts the deployment's
# entries from the pod env (DIVEAI_* / LITELLM_* — hermes style: refresh on
# every start, student-added providers untouched) and then starts or restarts
# the daemon as needed. This is the ONLY place that logic lives — the hub
# values files no longer carry a copy. This hook hardcodes NO provider: the
# first-run default is deployment policy, read by the CLI from the
# DSH_PROXY_DEFAULT_PROVIDER pod env (unset → nothing forced).
#
# Layering (mirrors the dsh runtime): the shim process runs from the conda env
# (ephemeral image layer) and logs to /tmp (ephemeral). It never writes to the
# user home; the only file it touches there is the student-owned proxy.conf,
# created by `dsh-proxy init` (ensure_default), which is idempotent.

# Best-effort: never let this break the notebook boot.
set +e

# Make DSH_HOME explicit so dsh-proxy / the shim and the dsh runtime agree on
# where profiles + proxy.conf live (defaults to ~/.dsh when unset, but being
# explicit avoids any ambiguity between the two).
export DSH_HOME="${DSH_HOME:-$HOME/.dsh}"
export DSH_SHIM_PORT="${DSH_SHIM_PORT:-8090}"

# ── Seed the default dsh model (hermes-style: default-on-first-run, never clobber) ──
#
# $HOME is the NFS mountpoint, so the image's /home/jovyan is fully shadowed —
# we cannot "bake" the default model into the home. On first boot the shim CLI
# writes ~/.dsh/settings.yaml, but it DISCOVERS both the model name and the
# context window from the endpoint's /v1/models (the same way hermes does) —
# this image bakes NO model name and NO contextWindow. The deployment policy
# (which model) is the DSH_DEFAULT_MODEL pod env; unset → the first model the
# endpoint advertises. It runs AFTER `dsh-proxy ensure` below so proxy.conf
# holds the deployment provider's base+key to query. Only written when the
# file is absent, so a student who later edits it keeps their choice.

if ! command -v dsh-proxy >/dev/null 2>&1; then
    echo "[dsh-proxy] dsh-proxy not on PATH; skipping shim start" >&2
    exit 0
fi

# `bash 40-dsh-proxy.sh status` → report and exit (used for diagnostics).
if [ "$1" = "status" ]; then
    dsh-proxy status
    exit $?
fi

# Single startup orchestrator: `dsh-proxy ensure` syncs the deployment's
# providers into ~/.dsh/proxy.conf from the pod env (DIVEAI_* / LITELLM_* —
# hermes-style: refresh on every start, never touch student-added providers),
# then STARTS the daemon if it is down or RESTARTS it if the sync changed
# anything. This is the ONLY place that logic lives: the hub values files no
# longer carry a copy (that duplication is what let them drift), and this hook
# does NOT hardcode any provider. Which provider a student gets on FIRST run
# is deployment policy, read by the CLI from DSH_PROXY_DEFAULT_PROVIDER in the
# pod env (unset → nothing forced; the student keeps/picks their own). Runs as
# the notebook user, whose env is the spawner environment — the same variables
# the hermes config sync consumes. Best-effort: a failure here must not block
# notebook boot (the daemon then just starts with whatever proxy.conf holds).
if dsh-proxy ensure >/tmp/dsh-proxy-ensure.log 2>&1; then
    echo "[dsh-proxy] ensure ok ($(tail -n1 /tmp/dsh-proxy-ensure.log 2>/dev/null))"
else
    echo "[dsh-proxy] WARNING: ensure failed; shim may be down (see /tmp/dsh-shim.log, /tmp/dsh-proxy-ensure.log)" >&2
fi

# Seed the default dsh model on FIRST boot only (settings.yaml absent). Runs
# after ensure so it can discover the model name + context window from the
# deployment provider's endpoint (base+key are in proxy.conf now). No model
# name or contextWindow is baked into the image — the deployment policy model
# is DSH_DEFAULT_MODEL (unset → first advertised model). No-op when the student
# already has a settings.yaml. Best-effort: a failure must not block notebook
# boot (dsh then just uses whatever it finds / the student picks a model).
if dsh-proxy seed-settings >/tmp/dsh-proxy-seed.log 2>&1; then
    tail -n1 /tmp/dsh-proxy-seed.log 2>/dev/null | grep -q "seeded" && \
        echo "[dsh-proxy] $(tail -n1 /tmp/dsh-proxy-seed.log 2>/dev/null)"
else
    echo "[dsh-proxy] WARNING: seed-settings failed (see /tmp/dsh-proxy-seed.log)" >&2
fi
exit 0
